{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Multi Repo DAG Plan v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["v", "workflow_id", "approved_brief_ref", "repos", "jobs", "release_cohort_id"],
  "properties": {
    "v": {"const": "1"},
    "workflow_id": {"type": "string", "minLength": 1},
    "approved_brief_ref": {"type": "string", "minLength": 1},
    "release_cohort_id": {"type": "string", "minLength": 1},
    "repos": {"type": "array", "minItems": 1, "items": {
      "type": "object", "additionalProperties": false,
      "required": ["repo_id", "remote_ref", "base_sha", "allowed_paths"],
      "properties": {
        "repo_id": {"type": "string", "minLength": 1},
        "remote_ref": {"type": "string", "minLength": 1},
        "base_sha": {"type": "string", "pattern": "^[a-fA-F0-9]{40}$"},
        "allowed_paths": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    }},
    "jobs": {"type": "array", "minItems": 1, "items": {
      "type": "object", "additionalProperties": false,
      "required": ["job_id", "repo_id", "role_id", "depends_on"],
      "properties": {
        "job_id": {"type": "string", "minLength": 1},
        "repo_id": {"type": "string", "minLength": 1},
        "role_id": {"type": "string", "minLength": 1},
        "depends_on": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    }}
  }
}
