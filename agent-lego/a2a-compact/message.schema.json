{
 "$schema":"https://json-schema.org/draft/2020-12/schema",
 "$id":"https://example.invalid/agent-lego/a2a-compact.v2.schema.json",
 "title":"A2A Compact v2 — attempt-fenced",
 "oneOf":[{"$ref":"#/$defs/task"},{"$ref":"#/$defs/result"}],
 "$defs":{
  "id":{"type":"string","minLength":1,"maxLength":128},"ref":{"type":"string","minLength":1,"maxLength":512},
  "refs":{"type":"array","minItems":1,"maxItems":32,"uniqueItems":true,"items":{"$ref":"#/$defs/ref"}},
  "shared":{"type":"object","properties":{"v":{"const":"2"},"job_id":{"$ref":"#/$defs/id"},"attempt_id":{"$ref":"#/$defs/id"},"fence_generation":{"type":"integer","minimum":1}}},
  "task":{"allOf":[{"$ref":"#/$defs/shared"}],"type":"object","additionalProperties":false,
   "required":["v","type","job_id","attempt_id","fence_generation","role","scope_ref","input_refs","acceptance_ref","policy_ref"],
   "properties":{"v":{"const":"2"},"type":{"const":"TASK"},"job_id":{"$ref":"#/$defs/id"},"attempt_id":{"$ref":"#/$defs/id"},"fence_generation":{"type":"integer","minimum":1},"role":{"$ref":"#/$defs/id"},"scope_ref":{"$ref":"#/$defs/ref"},"input_refs":{"$ref":"#/$defs/refs"},"acceptance_ref":{"$ref":"#/$defs/ref"},"policy_ref":{"$ref":"#/$defs/ref"}}
  },
  "result":{"type":"object","additionalProperties":false,
   "required":["v","type","job_id","attempt_id","fence_generation","state"],
   "properties":{"v":{"const":"2"},"type":{"const":"RESULT"},"job_id":{"$ref":"#/$defs/id"},"attempt_id":{"$ref":"#/$defs/id"},"fence_generation":{"type":"integer","minimum":1},"state":{"enum":["DONE","BLOCKED","FAILED"]},"artifact_refs":{"$ref":"#/$defs/refs"},"check_refs":{"$ref":"#/$defs/refs"},"reason_code":{"type":"string","pattern":"^[A-Z][A-Z0-9_]{1,63}$"},"next_action":{"type":"string","pattern":"^[A-Z][A-Z0-9_]{1,63}$"},"detail_ref":{"$ref":"#/$defs/ref"}},
   "allOf":[
    {"if":{"properties":{"state":{"const":"DONE"}},"required":["state"]},"then":{"required":["artifact_refs"]}},
    {"if":{"properties":{"state":{"const":"BLOCKED"}},"required":["state"]},"then":{"required":["reason_code","next_action"]}},
    {"if":{"properties":{"state":{"const":"FAILED"}},"required":["state"]},"then":{"required":["reason_code"]}}
   ]
  }
 }
}
